{
  "name": "@bismawy/pi-decision-eye",
  "version": "0.1.0",
  "type": "module",
  "description": "Multi-provider decision guard. Three-stage protection. Built for Pi. Blocks destructive bash/PowerShell commands and secrets offline, verifies test results on tool_result, gates diffs across 14 decision model providers, and tracks active-only spend in /decision usage.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "decision-models",
    "systemone",
    "guardrail",
    "supervisor",
    "security",
    "semantic-gate"
  ],
  "author": "bismawy",
  "license": "MIT",
  "scripts": {
    "dev": "pi -e ./extensions/index.ts",
    "test": "node --test",
    "render-check": "node --preserve-symlinks --preserve-symlinks-main scripts/render-check.mjs",
    "typecheck": "npx -y -p typescript@7.0.2 tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bismawy/pi-decision-eye.git"
  },
  "homepage": "https://github.com/bismawy/pi-decision-eye#readme",
  "bugs": {
    "url": "https://github.com/bismawy/pi-decision-eye/issues"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/bismawy/pi-decision-eye/main/assets/banner.webp",
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
